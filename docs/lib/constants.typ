
// docs/lib/constants.typ
// Zentrale Design-Konstanten für Typografie, Farben und Seitenränder

// Fonts
#let font-serif = "Libertinus Serif"
#let font-sans = "Arial"
#let font-cursive = "Marck Script"

// Colours
#let color-primary = rgb("#1a1a1a")
#let color-muted = gray.darken(30%)
#let color-accent = rgb("#1c3d5a")
#let color-number = rgb("#b22222")
#let color-heading-num = blue.darken(40%)
#let color-stroke = gray.lighten(50%)

// Page & Typography Metrics
#let page-size = "a5"
#let margin-inside = 2.5cm
#let margin-outside = 2cm
#let margin-y = 2.5cm
#let text-base-size = 10.5pt
#let leading-space = 0.65em
